   "source": [
    "def validate_username(username):\n",
    "    username = username.strip()\n",
    "\n",
    "    if len(username) >= 5 and username.isalnum():\n",
    "        return username.lower()\n",
    "    else:\n",
    "        return \"Invalid\"\n",
    "\n",
    "\n",
    "print(validate_username(\" CodeMaster99 \"))\n",
    "print(validate_username(\" Python_Dev \"))"
   ]
  }
